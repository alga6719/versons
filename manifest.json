{
  "manifest_version": 3,
  "name": "TrendIQ Dashboard Mock",
  "version": "1.0.0",
  "description": "Static mock dashboard for the TrendIQ token intelligence console.",
  "action": {
    "default_title": "TrendIQ Dashboard Mock",
    "default_popup": "dashboard.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.js",
        "token-manifest.json",
        "tf.min.js",
        "adaptive_weights.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
