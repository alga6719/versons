{\n  "manifest_version": 3,\n  "name": "Versons - TrendIQ (paper-trade test)",\n  "version": "0.1.0",\n  "description": "Test branch with in-browser paper trading and TF.js worker",\n  "action": { "default_popup": "dashboard.html" },\n  "options_ui": { "page": "options.html", "open_in_tab": true },\n  "permissions": [ "storage" ],\n  "host_permissions": [ "https://api.coingecko.com/*" ],\n  "web_accessible_resources": [\n    {\n      "resources": ["bots/*", "tf.min.js", "model/*"],\n      "matches": ["<all_urls>"]\n    }\n  ]\n}